<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme used during and after splash screen -->
    <style name="Theme.Isai.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Isai.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F3F4FF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Isai.Base</item>
    </style>
</resources>

